# BlindAssist Environment Configuration Example
# Copy to .env for local overrides

# Optional custom model path (default searches repo root and models/ directory)
BLINDASSIST_MODEL_PATH=yolo26s.pt

# Optional Ollama API endpoint for experimental Qwen Vision scene description
OLLAMA_API_URL=http://localhost:11434/api/chat

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

